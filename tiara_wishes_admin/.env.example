# Local Vite dev proxies /api and /media to the Flask app on port 5055.
# That keeps the session cookie on the admin origin.
VITE_API_BASE_URL=/api/v1

# Leave empty while using the Vite proxy. Set this when the API is on another host.
# VITE_MEDIA_ORIGIN=http://127.0.0.1:5055
VITE_MEDIA_ORIGIN=

# Direct API, without the proxy. The Flask CORS_ORIGINS value must include this site.
# VITE_API_BASE_URL=http://127.0.0.1:5055/api/v1
# VITE_MEDIA_ORIGIN=http://127.0.0.1:5055
