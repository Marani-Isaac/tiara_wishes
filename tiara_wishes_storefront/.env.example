# Local Vite dev proxies /api and /media to the Flask app on port 5055.
# The admin app uses port 5173. This storefront uses 5174 so both can run together.
VITE_API_BASE_URL=/api/v1

# Leave empty while using the Vite proxy. Set this when images are on another host.
# VITE_MEDIA_ORIGIN=http://127.0.0.1:5055
VITE_MEDIA_ORIGIN=

# Payment provider the API is actually running. mock matches the backend default.
# Use mpesa only when the API PAYMENT_PROVIDER is mpesa.
VITE_PAYMENT_PROVIDER=mock

# Direct API, without the proxy. Flask CORS_ORIGINS must include http://localhost:5174.
# VITE_API_BASE_URL=http://127.0.0.1:5055/api/v1
# VITE_MEDIA_ORIGIN=http://127.0.0.1:5055
